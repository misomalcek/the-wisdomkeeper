{
  "version": 1,
  "note": "Character models. A null glb means the engine sculpts the model procedurally (SDF + surface nets) on the same rig. Drop a rigged GLB (bone names as in src/assets/heroModel.ts, Draco or meshopt geometry, KTX2 textures) under public/assets/models/ and point glb at it; run `node scripts/copy-decoders.mjs` once so the decoders ship with the build.",
  "models": {
    "hero": {
      "glb": "models/hero.glb",
      "fallback": "sdf",
      "height": 2.1,
      "sockets": ["hand_r_root_blade", "back_thruster_pack", "head_antenna"],
      "variants": ["resonant", "verdant", "void"]
    },
    "voidRootFiend": { "glb": "models/void-root-fiend.glb", "fallback": "sdf", "sockets": ["weak_point_core"] },
    "nullSentryDrone": { "glb": "models/null-sentry-drone.glb", "fallback": "sdf", "sockets": ["eye_lens"] },
    "voidConstruct": { "glb": "models/void-construct.glb", "fallback": "sdf", "sockets": ["resonance_core", "conduit_l", "conduit_r"] },
    "nullSprite": { "glb": "models/null-sprite.glb", "fallback": "sdf", "sockets": ["heart"] },
    "thornCaster": { "glb": "models/thorn-caster.glb", "fallback": "sdf", "sockets": ["maw"] },
    "dataPylon": { "glb": "models/data-pylon.glb", "fallback": "sdf", "sockets": ["conduit_lens"] },
    "resonanceContact": { "glb": "models/resonance-contact.glb", "fallback": "sdf", "sockets": ["core"] },
    "datastreamDais": { "glb": "models/datastream-dais.glb", "fallback": "sdf", "sockets": ["lens"] },
    "rootBlade": { "glb": null, "fallback": "procedural", "sockets": ["grip"] }
  }
}
